    "typecheck": "npm run typecheck -w web",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "defuddle": "^0.19.3",
    "gray-matter": "^4.0.3",
    "jsdom": "^27.4.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "bun": "1.3.10"
  }
}
