{
  "name": "quant-research-wiki",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "research": "node scripts/agent/cli.mjs",
    "research:index": "node scripts/query/index.mjs",
    "research:mcp": "node scripts/agent/mcp.mjs",
    "research:package": "node scripts/agent/package.mjs",
    "research:share": "node scripts/agent/publish-install.mjs",
    "wiki": "node scripts/wiki.mjs",
